{
  "name": "crowdchat",
  "version": "1.0.0",
  "description": "Real-time web chat platform for a large public online community",
  "main": "server/server.js",
  "scripts": {
    "setup": "npm install && cd client && npm install && cd .. && npm run db:seed",
    "db:seed": "node server/db/seed.js",
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  },
  "keywords": ["chat", "realtime", "socket.io", "react", "sqlite"],
  "author": "CrowdChat Team",
  "license": "MIT"
}

.env.example

PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_crowdchat_jwt_key_change_in_production_998877
CLIENT_URL=http://localhost:5173
DATABASE_PATH=./server/db/crowdchat.db
MAX_FILE_SIZE_MB=10
DEFAULT_CHANNEL=main

